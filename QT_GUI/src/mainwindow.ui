   <property name="styleSheet">
    <string notr="true">QMainWindow, QWidget { background-color: #1e1e2e; color: #e4e4f4; font-family: &quot;Segoe UI&quot;, &quot;Microsoft YaHei UI&quot;, &quot;PingFang SC&quot;, sans-serif; font-size: 10pt; }
QStatusBar { background-color: #181825; color: #8a8aa3; border-top: 1px solid #313244; }
QToolTip { background-color: #313244; color: #e4e4f4; border: 1px solid #45475a; padding: 4px 6px; }
QGroupBox { background-color: #232336; border: 1px solid #313244; border-radius: 8px; margin-top: 14px; padding: 8px 6px 6px 6px; font-weight: bold; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; padding: 0 8px; color: #cdd6f4; background-color: transparent; font-size: 10pt; }
QPushButton { background-color: #313244; color: #e4e4f4; border: 1px solid #45475a; border-radius: 6px; padding: 6px 14px; min-height: 22px; }
QPushButton:hover { background-color: #3b3d52; }
QPushButton:pressed { background-color: #45475a; }
QPushButton:disabled { background-color: #232336; color: #6c7086; border-color: #313244; }
QPushButton#connectBtn { background-color: #89b4fa; color: #1e1e2e; border-color: #89b4fa; font-weight: bold; }
QPushButton#connectBtn:hover { background-color: #b4befe; }
QPushButton#connectBtn:pressed { background-color: #74a8f0; }
QPushButton#connectBtn:disabled { background-color: #45475a; color: #8a8aa3; border-color: #45475a; }
QPushButton#analyzeBtn { background-color: #313244; color: #cdd6f4; border-color: #45475a; }
QPushButton#analyzeBtn:hover { background-color: #3b3d52; }
QPushButton#analyzeBtn:checked { background-color: #a6e3a1; color: #1e1e2e; border-color: #a6e3a1; font-weight: bold; }
QPushButton#analyzeBtn:checked:hover { background-color: #b8ebae; }
QLabel#heatmapHint { color: #8a8aa3; font-size: 9pt; }
QLineEdit, QSpinBox, QDoubleSpinBox { background-color: #1e1e2e; color: #e4e4f4; border: 1px solid #45475a; border-radius: 5px; padding: 4px 6px; selection-background-color: #89b4fa; selection-color: #1e1e2e; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus { border-color: #89b4fa; }
QSpinBox::up-button, QSpinBox::down-button { background-color: transparent; border: none; width: 16px; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background-color: #45475a; }
QCheckBox { color: #e4e4f4; spacing: 6px; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #45475a; border-radius: 3px; background-color: #1e1e2e; }
QCheckBox::indicator:hover { border-color: #89b4fa; }
QCheckBox::indicator:checked { background-color: #89b4fa; border-color: #89b4fa; }
QProgressBar { background-color: #1e1e2e; border: 1px solid #313244; border-radius: 4px; text-align: center; color: #e4e4f4; min-height: 14px; }
QProgressBar::chunk { background-color: #a6e3a1; border-radius: 3px; }
QSplitter::handle { background-color: #313244; }
QSplitter::handle:horizontal { width: 6px; }
QSplitter::handle:vertical { height: 6px; }
QSplitter::handle:hover { background-color: #45475a; }
QLabel[role=&quot;alert&quot;] { background-color: #f38ba8; color: #1e1e2e; border-radius: 6px; padding: 6px 12px; font-size: 12pt; font-weight: bold; }
QFrame#dCard { background-color: #1a1a28; border: 1px solid #313244; border-radius: 8px; }
QFrame#dCard QLabel { color: #e4e4f4; }
QFrame#dCard QLabel#dLabel, QFrame#dCard QLabel#cLabel, QFrame#dCard QLabel#wLabel, QFrame#dCard QLabel#dUnit, QFrame#dCard QLabel#cUnit, QFrame#dCard QLabel#wUnit { color: #8a8aa3; }
QFrame#dCard QLabel#dValue { color: #89b4fa; font-size: 28pt; font-weight: bold; }
QFrame#dCard QLabel#cValue, QFrame#dCard QLabel#wValue { color: #e4e4f4; font-size: 14pt; font-weight: 600; }
QFrame#dCard QLabel#dUnit, QFrame#dCard QLabel#cUnit, QFrame#dCard QLabel#wUnit { font-size: 10pt; }
QWidget#statusConnRow QLabel { font-size: 11pt; }
QLabel#alertHelpText { color: #8a8aa3; font-size: 9pt; }
QFrame#logBody { background-color: #181825; border: 1px solid #313244; border-radius: 6px; }
QLabel#logHint { color: #8a8aa3; font-size: 9pt; padding: 4px 6px; }
QToolButton#logClearBtn { background-color: transparent; color: #8a8aa3; border: 1px solid #45475a; border-radius: 4px; padding: 2px 10px; }
QToolButton#logClearBtn:hover { color: #e4e4f4; border-color: #89b4fa; }
QPlainTextEdit#logEdit { background-color: #181825; color: #e4e4f4; border: none; border-top: 1px solid #313244; border-bottom-left-radius: 6px; border-bottom-right-radius: 6px; padding: 4px 6px; font-family: &quot;Consolas&quot;, &quot;Cascadia Mono&quot;, monospace; font-size: 9pt; }
QPlainTextEdit#logEdit QScrollBar:vertical { background: #181825; width: 10px; margin: 0; }
QPlainTextEdit#logEdit QScrollBar::handle:vertical { background: #45475a; border-radius: 4px; min-height: 24px; }
QPlainTextEdit#logEdit QScrollBar::handle:vertical:hover { background: #585b70; }
QPlainTextEdit#logEdit QScrollBar::add-line:vertical, QPlainTextEdit#logEdit QScrollBar::sub-line:vertical { height: 0; }
QToolButton#logToggleBtn { background-color: transparent; color: #8a8aa3; border: 1px solid #45475a; border-radius: 4px; padding: 1px 10px; }
QToolButton#logToggleBtn:hover { color: #e4e4f4; border-color: #89b4fa; }
QToolButton#logToggleBtn:checked { color: #89b4fa; border-color: #89b4fa; }
QLabel[state=&quot;READY&quot;] { color: #a6e3a1; font-size: 12pt; }
QLabel[state=&quot;CALIBRATING&quot;] { color: #fab387; font-size: 12pt; }
QLabel[state=&quot;IDLE&quot;] { color: #8a8aa3; font-size: 12pt; }
QLabel[state=&quot;online&quot;] { color: #a6e3a1; font-size: 12pt; }
QLabel[state=&quot;connecting&quot;] { color: #fab387; font-size: 12pt; }
QLabel[state=&quot;offline&quot;] { color: #f38ba8; font-size: 12pt; }</string>
   </property>
  </widget>
  <widget class="QStatusBar" name="statusbar"/>
 </widget>
